# =============================================================================
# AI Agent for Smart Farming Advice — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env with real secrets to version control.

# -----------------------------------------------------------------------------
# IBM watsonx.ai (Granite LLM) — https://cloud.ibm.com/apidocs/watsonx-ai
# -----------------------------------------------------------------------------
IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Granite model to use (IBM Granite 13B Instruct v2 — available on IBM Cloud Lite)
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Optional: IBM Granite embedding model for RAG vector store
IBM_GRANITE_EMBED_MODEL_ID=ibm/slate-125m-english-rtrvr

# -----------------------------------------------------------------------------
# IBM Cloud Object Storage (COS) — for knowledge base documents
# -----------------------------------------------------------------------------
IBM_COS_API_KEY=your_ibm_cos_api_key_here
IBM_COS_INSTANCE_ID=your_ibm_cos_instance_id_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET_NAME=smart-farming-knowledge-base

# -----------------------------------------------------------------------------
# IBM Watson Discovery (optional — for document retrieval)
# -----------------------------------------------------------------------------
IBM_DISCOVERY_API_KEY=your_ibm_discovery_api_key_here
IBM_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
IBM_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# -----------------------------------------------------------------------------
# IBM Natural Language Understanding — language detection & translation
# -----------------------------------------------------------------------------
IBM_NLU_API_KEY=your_ibm_nlu_api_key_here
IBM_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# IBM Language Translator (for local-language support)
IBM_TRANSLATOR_API_KEY=your_ibm_translator_api_key_here
IBM_TRANSLATOR_URL=https://api.us-south.language-translator.watson.cloud.ibm.com

# -----------------------------------------------------------------------------
# External Data APIs
# -----------------------------------------------------------------------------
# OpenWeatherMap — weather forecasts (free tier available)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# AgMarkNet / Government Mandi Prices (India Agri Market)
AGMARKNET_API_KEY=your_agmarknet_api_key_here
AGMARKNET_BASE_URL=https://api.data.gov.in/resource

# data.gov.in Open Government Data API
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# SoilGrids API (ISRIC — free, no key needed)
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change_this_to_a_random_secret_key_32chars

# Supported languages (ISO 639-1 codes, comma-separated)
SUPPORTED_LANGUAGES=en,hi,te,ta,kn,mr,bn,pa,gu,ml

# Default language fallback
DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# RAG / Vector Store Settings
# -----------------------------------------------------------------------------
# Local ChromaDB path (no external service needed for development)
CHROMA_PERSIST_DIR=./data/chroma_db

# Chunk size for document splitting
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# -----------------------------------------------------------------------------
# Redis Cache (optional — for rate limiting and session caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
